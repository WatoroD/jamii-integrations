<?xml version="1.0" encoding="UTF-8"?>
<!--
  Common request entry point for every Jamii API.
  Expects (set by the caller):  jamii.api     - logical API name for logs
                                jamii.rawRef  - business identifier to mask in logs (optional)
  Produces:  jamii.requestId, jamii.correlationId, jamii.timestamp, jamii.startTime, jamii.maskedRef
-->
<sequence name="Jamii_InitRequest" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
  <property name="jamii.startTime" expression="get-property('SYSTEM_TIME')" scope="default" type="STRING"/>
  <!-- MessageID is a per-message UUID (urn:uuid:...) generated by the runtime -->
  <property name="jamii.requestId" expression="substring-after(get-property('MessageID'), 'urn:uuid:')" scope="default" type="STRING"/>
  <property name="jamii.timestamp" expression="get-property('SYSTEM_DATE', &quot;yyyy-MM-dd'T'HH:mm:ss.SSSXXX&quot;)" scope="default" type="STRING"/>

  <!-- Correlation ID: honour the caller's value only if it is well-formed (prevents log forging /
       header injection); otherwise mint one from the request ID. -->
  <property name="jamii.correlationId" expression="$trp:X-Correlation-ID" scope="default" type="STRING"/>
  <filter source="get-property('jamii.correlationId')" regex="^[A-Za-z0-9._:\-]{8,64}$">
    <then>
      <property name="jamii.correlationIdSource" value="caller" scope="default" type="STRING"/>
    </then>
    <else>
      <property name="jamii.correlationId" expression="get-property('jamii.requestId')" scope="default" type="STRING"/>
      <property name="jamii.correlationIdSource" value="generated" scope="default" type="STRING"/>
    </else>
  </filter>

  <!-- Mask the business identifier for logging: keep only the last 4 characters. -->
  <filter xpath="string-length(get-property('jamii.rawRef')) &gt;= 8 and string-length(get-property('jamii.rawRef')) &lt;= 40">
    <then>
      <property name="jamii.maskedRef" scope="default" type="STRING"
                expression="concat(substring('****************************************', 1, string-length(get-property('jamii.rawRef')) - 4), substring(get-property('jamii.rawRef'), string-length(get-property('jamii.rawRef')) - 3))"/>
    </then>
    <else>
      <property name="jamii.maskedRef" value="****" scope="default" type="STRING"/>
    </else>
  </filter>

  <!-- Strip headers that must never travel to a backend (credentials, gateway internals). -->
  <header name="Authorization" scope="transport" action="remove"/>
  <header name="Cookie" scope="transport" action="remove"/>
  <header name="apikey" scope="transport" action="remove"/>
  <header name="Internal-Key" scope="transport" action="remove"/>
  <header name="X-JWT-Assertion" scope="transport" action="remove"/>
  <header name="X-Internal-User" scope="transport" action="remove"/>
  <header name="X-Internal-Debug" scope="transport" action="remove"/>
  <header name="X-Internal-Trace" scope="transport" action="remove"/>
  <header name="X-Forwarded-For" scope="transport" action="remove"/>
  <!-- Propagate the normalised IDs downstream. -->
  <header name="X-Correlation-ID" scope="transport" expression="get-property('jamii.correlationId')"/>
  <header name="X-Request-ID" scope="transport" expression="get-property('jamii.requestId')"/>

  <log category="INFO" level="custom">
    <property name="event" value="REQUEST_IN"/>
    <property name="api" expression="get-property('jamii.api')"/>
    <property name="method" expression="$axis2:HTTP_METHOD"/>
    <property name="ref" expression="get-property('jamii.maskedRef')"/>
    <property name="requestId" expression="get-property('jamii.requestId')"/>
    <property name="correlationId" expression="get-property('jamii.correlationId')"/>
    <property name="correlationIdSource" expression="get-property('jamii.correlationIdSource')"/>
    <!-- set by the APIM jamiiConsumerContext policy; MI is not reachable except via the gateway -->
    <property name="consumerApp" expression="substring($trp:X-Jamii-Consumer-App, 1, 64)"/>
  </log>
</sequence>
