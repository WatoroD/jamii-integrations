# Dev: the docker-compose environment (wired up).
ENV_NAME=dev
APICTL_ENV=dev
APIM_URL=https://localhost:9443
APIM_GATEWAY_URL=https://localhost:8243
MI_MGMT_URL=https://localhost:9164/management
MI_HTTP_URL=http://localhost:8290
# How the CAR reaches the runtime: "hotdeploy" copies into a directory the MI container mounts.
MI_DEPLOY_MODE=hotdeploy
MI_CARBONAPPS_DIR=docker/runtime/mi-carbonapps
# Credentials come from the environment (Jenkins credentials binding); defaults are the
# out-of-the-box WSO2 admin users of the throwaway compose stack.
APIM_USER=${APIM_USER:-admin}
APIM_PASSWORD=${APIM_PASSWORD:-admin}
MI_USER=${MI_USER:-admin}
MI_PASSWORD=${MI_PASSWORD:-admin}
# Gateway smoke tests create a throwaway DevPortal app/subscription.
GATEWAY_SMOKE=true
DEPLOY_TIMEOUT_SECONDS=180
