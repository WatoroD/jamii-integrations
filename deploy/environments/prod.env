# Prod: conceptual only - hosts are placeholders and NOT wired up in this assignment.
# The pipeline promotes the *same* CAR and API bundles that passed dev.
ENV_NAME=prod
APICTL_ENV=prod
APIM_URL=https://apim.prod.jamii.internal
APIM_GATEWAY_URL=https://gw.jamii.co.ke
MI_MGMT_URL=https://mi.prod.jamii.internal:9164/management
MI_HTTP_URL=
# In prod the CAR would ship inside an immutable MI image rolled out by the platform
# (e.g. Kubernetes). "image" mode builds/pushes that image; the rollout itself is platform-specific.
MI_DEPLOY_MODE=image
MI_IMAGE_REPO=registry.jamii.internal/integration/jamii-mi
APIM_USER=${APIM_USER:?APIM_USER must come from Jenkins credentials}
APIM_PASSWORD=${APIM_PASSWORD:?APIM_PASSWORD must come from Jenkins credentials}
MI_USER=${MI_USER:?MI_USER must come from Jenkins credentials}
MI_PASSWORD=${MI_PASSWORD:?MI_PASSWORD must come from Jenkins credentials}
GATEWAY_SMOKE=false
DEPLOY_TIMEOUT_SECONDS=600
